# Canonical public origin for Open Graph tags, sitemap.xml, and robots.txt.
# Required on Vercel production (https only; no placeholder or localhost).
# For local/dev, omit this variable to use http://localhost:3000, or set it
# explicitly for production-mode builds and Playwright/Lighthouse.
# Do not ship fruiticana.example.com or other placeholders.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

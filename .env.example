# Canonical public URL used for Open Graph tags, sitemap.xml, and robots.txt.
# Set this to the production domain in Vercel (for example https://www.fruiticana.com).
# If unset, the app falls back to https://fruiticana.example.com so local builds
# still succeed — do not ship that placeholder URL to production.
NEXT_PUBLIC_SITE_URL=https://fruiticana.example.com
